.terraform/
# .terraform.lock.hcl IS committed on purpose — it pins provider versions and
# hashes, so a clone reproduces the same plan. Reproducibility is the point.
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
# Concrete backend values embed the account ID. example.backend.hcl is the
# committed template; this exact name is not.
backend.hcl
tfplan
*.tfplan
crash.log
.infracost/
.env
*.pem
